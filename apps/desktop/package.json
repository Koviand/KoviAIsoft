{
  "name": "@kovi/desktop",
  "version": "0.1.1",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsc -p tsconfig.json && electron .",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "electron .",
    "pack:win": "node ../../scripts/pack-portable.mjs"
  },
  "dependencies": {
    "@kovi/core": "workspace:*",
    "@kovi/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "electron": "^34.0.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3"
  },
  "build": {
    "appId": "com.kovi.aisoft",
    "productName": "KoviAIsoft",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "package.json",
      {
        "from": "../../packages/core/dist",
        "to": "node_modules/@kovi/core/dist"
      },
      {
        "from": "../../packages/core/package.json",
        "to": "node_modules/@kovi/core/package.json"
      },
      {
        "from": "../../packages/shared/dist",
        "to": "node_modules/@kovi/shared/dist"
      },
      {
        "from": "../../packages/shared/package.json",
        "to": "node_modules/@kovi/shared/package.json"
      }
    ],
    "extraResources": [
      {
        "from": "../ui/dist",
        "to": "ui"
      }
    ],
    "asar": true,
    "win": {
      "target": ["nsis", "portable", "dir"],
      "icon": "build/icon.png",
      "artifactName": "KoviAIsoft-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KoviAIsoft",
      "artifactName": "KoviAIsoft-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "KoviAIsoft-${version}-portable.${ext}"
    }
  }
}
